{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "dist",

    "paths": {
      "@/*": ["./src/*"],
    },
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src", "drizzle.config.ts"]
}